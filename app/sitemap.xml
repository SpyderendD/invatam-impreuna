// app/sitemap.ts
import { MetadataRoute } from 'next';
import { ALL_SUBJECTS_OBJECT } from '@/lib/lessons'; // Importăm structura lecțiilor

const SITE_URL = 'https://invatam-impreuna.vercel.app';

export default function sitemap(): MetadataRoute.Sitemap {
  // 1. Adăugăm paginile statice (cele care nu se schimbă)
  const staticRoutes = [
    '/',
    '/login',
    '/register',
    '/dashboard',
    '/profil',
    '/modele-teste',
    '/studiu',
    '/studiu-inteligent',
    '/contact',
    '/termeni',
    '/politica-confidentialitate',
    '/cookies',
    '/blog',
  ].map((route) => ({
    url: `${SITE_URL}${route}`,
    lastModified: new Date().toISOString(),
    changeFrequency: 'monthly' as 'monthly', // Aceste pagini nu se schimbă des
    priority: route === '/' ? 1.0 : 0.8,
  }));

  // 2. Adăugăm paginile dinamice pentru materii
  const subjectRoutes = Object.keys(ALL_SUBJECTS_OBJECT).map((subjectSlug) => ({
    url: `${SITE_URL}/materii/${subjectSlug}`,
    lastModified: new Date().toISOString(),
    changeFrequency: 'weekly' as 'weekly', // Materiile se pot actualiza
    priority: 0.9,
  }));

  // 3. Adăugăm paginile dinamice pentru lecții
  const lessonRoutes = Object.entries(ALL_SUBJECTS_OBJECT).flatMap(([subjectSlug, subjectData]) =>
    (subjectData.chapters || []).flatMap((chapter: any) =>
      (chapter.lessons || []).map((lesson: any) => ({
        url: `${SITE_URL}/materii/${subjectSlug}/${lesson.slug}`,
        lastModified: new Date().toISOString(),
        changeFrequency: 'weekly' as 'weekly',
        priority: 0.7,
      }))
    )
  );

  // Combinăm toate rutele
  return [...staticRoutes, ...subjectRoutes, ...lessonRoutes];
}```

### **Ce face acest cod?**

1.  **Pagini Statice:** Creează o listă cu toate paginile tale principale (Home, Login, Contact etc.) și le adaugă în sitemap. Pagina de start (`/`) are prioritatea cea mai mare (`1.0`).
2.  **Pagini Dinamice (Materii):** Parcurge automat lista ta de materii din `lib/lessons.ts` și adaugă câte o intrare pentru fiecare (ex: `/materii/romana`, `/materii/matematica`).
3.  **Pagini Dinamice (Lecții):** Parcurge automat **toate lecțiile din toate capitolele din toate materiile** și adaugă câte o intrare pentru fiecare (ex: `/materii/romana/subiectul`).
4.  **`lastModified`:** Setează data curentă ca fiind data ultimei modificări, semnalând lui Google că paginile sunt proaspete.